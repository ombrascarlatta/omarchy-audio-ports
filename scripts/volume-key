#!/usr/bin/bash
# volume-key <raise|lower|mute-toggle|+N|-N>
#   Runs Omarchy's own volume-key command (the one bound to XF86Audio*), so the
#   bar widget changes volume and shows exactly the same OSD as the media keys.
set -euo pipefail
# shellcheck source=scripts/common.sh
source "$(dirname "$(readlink -f "$0")")/common.sh"

action=${1:-}
[[ $action == raise || $action == lower || $action == mute-toggle || $action =~ ^[+-][0-9]{1,3}$ ]] \
  || { echo "usage: volume-key <raise|lower|mute-toggle|+N|-N>" >&2; exit 64; }
helper=$(tool omarchy-audio-output-volume) || { echo "omarchy-audio-output-volume is unavailable" >&2; exit 69; }
exec "$timeout_bin" -k 1s 5s "$helper" "$action"
